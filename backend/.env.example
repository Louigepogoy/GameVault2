# Neon connection string (Neon Console -> Connect -> copy the pooled connection string)
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require
PORT=4000
# Comma-separated list of allowed frontend origins (leave empty to allow all)
CORS_ORIGIN=http://localhost:5173

# Secret used to sign login tokens. Use a long random string, e.g. the output of:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string

# Frontend address, used to build the link in password reset emails
FRONTEND_URL=http://localhost:3000

# Optional SMTP settings for sending password reset emails.
# If SMTP_HOST is empty, the reset link is printed in the backend terminal instead.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="GameVault <no-reply@example.com>"

# Google sign-in: OAuth Client ID from Google Cloud Console (same value as the frontend's).
# Leave empty to turn Google sign-in off.
GOOGLE_CLIENT_ID=

# ---------- Error monitoring (optional) ----------
# Sentry DSN from sentry.io -> Project settings -> Client Keys. Leave empty to turn Sentry off.
# Passwords, tokens and email addresses are removed from reports before they're sent.
SENTRY_DSN=
# Defaults to Vercel's environment (production/preview) or NODE_ENV.
SENTRY_ENVIRONMENT=

# ---------- Tests ----------
# `npm test` wipes this database. Never point it at your real one.
# Leave empty to use an in-memory database (PGlite): no setup needed.
TEST_DATABASE_URL=
