# Base URL of the Express API (no trailing slash, without /api)
# Local:      http://localhost:4000
# Production: https://your-gamevault-api.onrender.com
NUXT_PUBLIC_API_URL=http://localhost:4000

# Google sign-in: OAuth Client ID from Google Cloud Console (same value as the backend's).
# Leave empty to hide the "Sign in with Google" button.
NUXT_PUBLIC_GOOGLE_CLIENT_ID=

# Error monitoring (optional). Sentry DSN for the browser; leave empty to turn it off.
NUXT_PUBLIC_SENTRY_DSN=
NUXT_PUBLIC_SENTRY_ENVIRONMENT=

# Build-time only (CI secrets or Vercel env vars), to upload source maps to Sentry.
# The .map files are deleted from the build after uploading.
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=
